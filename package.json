{
  "name": "eip681-kit",
  "version": "1.2.1",
  "description": "Strict EIP-681 payment URI parser, validator, formatter and CLI. Zero dependencies.",
  "type": "module",
  "main": "index.mjs",
  "bin": {
    "eip681": "cli.mjs"
  },
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "import": "./index.mjs",
      "default": "./index.mjs"
    },
    "./split": {
      "import": "./split.mjs",
      "default": "./split.mjs"
    },
    "./strict": {
      "import": "./strict.mjs",
      "default": "./strict.mjs"
    },
    "./eip681": {
      "import": "./eip681.mjs",
      "default": "./eip681.mjs"
    },
    "./derive": {
      "import": "./deriveEip681.mjs",
      "default": "./deriveEip681.mjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "node tools/run-chain.cjs",
    "test:parser": "node test.mjs",
    "test:derive": "node deriveEip681.test.mjs",
    "test:cli": "node cli.test.mjs",
    "test:split": "node split.test.cjs",
    "conformance": "node conformance/run.mjs && node conformance/vectors.run.mjs",
    "test:all": "node tools/build_types.mjs && node types.test.mjs && node test.mjs && node cli.test.mjs && node deriveEip681.test.mjs && node padding-edge.test.mjs && node split.test.cjs && node adversarial.mjs && node conformance/run.mjs && node conformance/vectors.run.mjs && node tools/verify_conformance_page.mjs && node conformance/check.mjs conformance/adapters/kit.mjs",
    "lint:rust": "node tools/check_unrecognised.mjs tools/fixtures",
    "selfcheck": "node tools/check_unrecognised.mjs tools/fixtures",
    "test:adversarial": "node adversarial.mjs",
    "conformance:vectors": "node conformance/vectors.run.mjs",
    "conformance:generated": "node conformance/gen_vectors.mjs",
    "conformance:gen": "node conformance/gen_vectors.mjs",
    "conformance:page": "node tools/build_conformance_page.mjs && node tools/verify_conformance_page.mjs",
    "conformance:check": "node conformance/check.mjs conformance/adapters/kit.mjs",
    "conformance:check:naive": "node conformance/check.mjs conformance/adapters/naive.mjs",
    "build:types": "node tools/build_types.mjs",
    "test:types": "node types.test.mjs",
    "prove:exports": "node tools/prove-exports.cjs",
    "test:selftest": "node tools/run-chain.cjs --selftest"
  },
  "files": [
    "LICENSE",
    "README.md",
    "adversarial.mjs",
    "cli.mjs",
    "conformance/.gitignore",
    "conformance/HOWTO.md",
    "conformance/README.md",
    "conformance/SUBJECTS.md",
    "conformance/adapters/kit.mjs",
    "conformance/adapters/naive.mjs",
    "conformance/build-subjects.cjs",
    "conformance/check-rejection-safety.mjs",
    "conformance/check.mjs",
    "conformance/gen-and-publish.cjs",
    "conformance/gen_vectors.mjs",
    "conformance/recipient-length.json",
    "conformance/rejection-safety.json",
    "conformance/run-against-parser.cjs",
    "conformance/run.mjs",
    "conformance/stranger-install.mjs",
    "conformance/vectors.json",
    "conformance/vectors.ndjson",
    "conformance/vectors.run.mjs",
    "conformance/vectors.tsv",
    "deriveEip681.mjs",
    "eip681.mjs",
    "index.d.ts",
    "index.mjs",
    "split.mjs",
    "strict.mjs",
    "tools/prove-exports.cjs",
    "tools/run-chain.cjs",
    "vectors/README.md",
    "vectors/eip681-vectors.json",
    "vectors/eip681.conformance.json"
  ],
  "keywords": [
    "eip-681",
    "eip681",
    "ethereum",
    "payment-uri",
    "payment-link",
    "usdc",
    "erc20",
    "validation",
    "eip-55",
    "zero-dependency",
    "cli",
    "payment-split"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "types": "index.d.ts"
}
